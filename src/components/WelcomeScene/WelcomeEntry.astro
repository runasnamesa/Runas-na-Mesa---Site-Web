---
/**
 * Abertura da Taverna — o viajante na nevasca.
 *
 * Você é um viajante cansado e perdido; o peso da vida é a nevasca, e a cada
 * passo o vento fica mais forte. No meio da escuridão, uma luz quente chama
 * sua atenção. Ao se aproximar, você vê uma porta. Ao tocar, ela se abre e a
 * luz da lareira da taverna toma tudo.
 *
 * As imagens e o vídeo da porta foram gerados no Higgsfield
 * (public/abertura/): a cena distante, a porta de perto e a porta se abrindo
 * (o primeiro quadro do vídeo é a própria imagem de perto). Por cima, em
 * canvas: a nevasca que piora a cada frase, rajadas e névoa.
 */

// Pontos de interesse nas imagens (frações da largura/altura da imagem 16:9).
const FAR_DOOR = { x: 0.616, y: 0.615 };
const NEAR = {
  door: { x0: 0.235, x1: 0.49, y0: 0.16, y1: 0.89 },
  lantern: { x: 0.594, y: 0.42 },
  windows: [
    { x: 0.31, y: 0.46 },
    { x: 0.436, y: 0.47 },
  ],
  sill: { x: 0.36, y: 0.86 },
};
// Recorte no celular (retrato): manter a porta enquadrada.
const NEAR_POS_X = 0.4;
const FAR_POS_X = 0.6;
---

<div
  id="welcome-experience"
  class="welcome-experience"
  data-far={JSON.stringify(FAR_DOOR)}
  data-near={JSON.stringify(NEAR)}
  data-near-pos={NEAR_POS_X}
  data-far-pos={FAR_POS_X}
>
  <div class="stage" id="stage">
    <!-- Plano distante: o vale congelado, a porta minúscula ao pé do penhasco. -->
    <div class="plate plate--far" id="plate-far">
      <img
        src="/abertura/longe-1920.webp"
        srcset="/abertura/longe-1280.webp 1280w, /abertura/longe-1920.webp 1920w"
        sizes="100vw"
        alt=""
        fetchpriority="high"
        decoding="async"
      />
      <!-- A luz da porta: sem cor até "uma luz chama sua atenção" (ver buildScene). -->
      <div class="far-light" id="far-light"></div>
    </div>

    <!-- Plano próximo: a porta da taverna cravada na rocha. -->
    <div class="plate plate--near" id="plate-near">
      <img
        src="/abertura/porta-1920.webp"
        srcset="/abertura/porta-1280.webp 1280w, /abertura/porta-1920.webp 1920w"
        sizes="100vw"
        alt=""
        decoding="async"
      />
      <div class="glow glow--lantern" id="glow-lantern"></div>
      <div class="glow glow--window" id="glow-window-a"></div>
      <div class="glow glow--window" id="glow-window-b"></div>
      <div class="glow glow--sill" id="glow-sill"></div>
    </div>

    <!-- A porta se abrindo (primeiro quadro = imagem de perto). -->
    <video
      class="plate plate--video"
      id="door-video"
      muted
      playsinline
      preload="auto"
      poster="/abertura/porta-abre-poster.jpg"
    >
      <source src="/abertura/porta-abre.webm" type="video/webm" />
      <source src="/abertura/porta-abre.mp4" type="video/mp4" />
    </video>
  </div>

  <canvas id="snow-back" class="fx-canvas fx-canvas--back"></canvas>
  <div class="fog fog--a" id="fog-a"></div>
  <div class="fog fog--b" id="fog-b"></div>
  <canvas id="snow-front" class="fx-canvas fx-canvas--front"></canvas>
  <div class="gust" id="gust"></div>
  <div class="darkness" id="darkness"></div>
  <div class="vignette"></div>

  <div class="narrative" id="narrative-text">
    <p class="narrative-line" style="animation-delay: 0.6s;">Cansado. Perdido.</p>
    <p class="narrative-line" style="animation-delay: 1.9s;">O peso da vida fica mais denso a cada passo.</p>
    <p class="narrative-line" style="animation-delay: 3.2s;">O vento aumenta. O frio não tem piedade.</p>
    <p class="narrative-line" style="animation-delay: 4.5s;">Sozinho na montanha gelada, você sente que é o fim.</p>
    <p class="narrative-line narrative-line--emphasis" style="animation-delay: 6s;">Então, no meio da escuridão...</p>
    <p class="narrative-line narrative-line--emphasis" style="animation-delay: 7.2s;">uma luz chama sua atenção.</p>
  </div>
  <p class="caption" id="caption">Ao se aproximar, você vê uma porta.</p>

  <button class="door-hit" id="door-btn" type="button" aria-label="Abrir a porta e entrar na taverna" disabled></button>
  <p class="door-prompt" id="door-prompt" aria-hidden="true">Toque na porta para entrar</p>

  <div class="flash" id="flash"></div>

  <div class="ui-controls">
    <button class="ui-btn" id="skip-btn" type="button">Pular</button>
    <button class="ui-btn ui-btn-sound" id="sound-btn" type="button" aria-pressed="false" aria-label="Ativar som">
      <svg class="sound-icon" width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
        <path d="M10 4L6 8H3v4h3l4 4V4z" fill="currentColor" />
        <path class="sound-waves" d="M13 7c1 1 1 5 0 6M15 5c2 2 2 8 0 10" stroke="currentColor" fill="none" />
      </svg>
    </button>
  </div>

  <div class="sr-only" id="sr-announce" aria-live="polite" aria-atomic="true"></div>
</div>

<style>
  :global(html), :global(body) {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #000;
  }

  .welcome-experience {
    position: fixed;
    inset: 0;
    overflow: hidden;
    background: #05080e;
    font-family: 'Cinzel', serif;
    z-index: 9999;
  }

  .stage { position: absolute; inset: 0; z-index: 1; overflow: hidden; }
  .plate {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    will-change: transform, opacity, filter;
  }
  .plate img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--pos-x, 50%) 50%;
  }
  .plate--far { --pos-x: 60%; }
  .plate--near { --pos-x: 40%; opacity: 0; }
  .plate--video {
    object-fit: cover;
    object-position: 40% 50%;
    opacity: 0;
    background: #05080e;
  }

  /* Luz da porta lá longe: escondida pelo véu, depois brilha e pulsa. */
  .far-light, .glow {
    position: absolute;
    left: 0;
    top: 0;
    border-radius: 50%;
    pointer-events: none;
    transform: translate(-50%, -50%);
  }
  .far-light {
    width: 28vmin;
    height: 28vmin;
    background: radial-gradient(circle, rgba(255, 214, 150, 0.85) 0%, rgba(255, 170, 80, 0.35) 18%, rgba(230, 130, 50, 0.1) 45%, transparent 70%);
    mix-blend-mode: screen;
    opacity: 0;
  }
  /* Tremulação da lanterna e das janelas, presa aos pontos da imagem. */
  .glow { mix-blend-mode: screen; opacity: 0.7; }
  .glow--lantern {
    width: 26vmin;
    height: 26vmin;
    background: radial-gradient(circle, rgba(255, 190, 110, 0.5) 0%, rgba(255, 150, 70, 0.18) 35%, transparent 70%);
  }
  .glow--window {
    width: 9vmin;
    height: 9vmin;
    background: radial-gradient(circle, rgba(255, 200, 120, 0.45) 0%, transparent 70%);
  }
  .glow--sill {
    width: 40vmin;
    height: 10vmin;
    background: radial-gradient(ellipse, rgba(255, 170, 90, 0.35) 0%, transparent 70%);
  }

  .fx-canvas { position: absolute; inset: 0; pointer-events: none; }
  .fx-canvas--back { z-index: 2; }
  .fx-canvas--front { z-index: 5; }

  .fog {
    position: absolute;
    left: -50%;
    width: 200%;
    pointer-events: none;
    z-index: 4;
  }
  .fog--a {
    top: 25%;
    height: 80%;
    background:
      radial-gradient(ellipse 18% 30% at 15% 50%, rgba(170, 190, 215, 0.14), transparent 70%),
      radial-gradient(ellipse 22% 35% at 45% 60%, rgba(170, 190, 215, 0.12), transparent 70%),
      radial-gradient(ellipse 20% 30% at 80% 45%, rgba(170, 190, 215, 0.13), transparent 70%);
    animation: drift 24s linear infinite;
  }
  .fog--b {
    top: 50%;
    height: 55%;
    background:
      radial-gradient(ellipse 25% 40% at 25% 70%, rgba(150, 170, 200, 0.16), transparent 70%),
      radial-gradient(ellipse 25% 40% at 70% 65%, rgba(150, 170, 200, 0.14), transparent 70%);
    animation: drift 15s linear infinite reverse;
  }
  @keyframes drift { from { transform: translateX(0); } to { transform: translateX(25%); } }

  /* Rajada de neve que cobre a passagem do plano distante para o próximo. */
  .gust {
    position: absolute;
    inset: 0;
    z-index: 6;
    pointer-events: none;
    background: radial-gradient(ellipse at 50% 55%, rgba(200, 215, 235, 0.85), rgba(150, 170, 200, 0.55) 55%, rgba(40, 55, 80, 0.35) 100%);
    filter: blur(8px);
    opacity: 0;
  }
  .darkness {
    position: absolute;
    inset: 0;
    z-index: 6;
    pointer-events: none;
    background: #04070c;
    opacity: 0.3;
  }
  .vignette {
    position: absolute;
    inset: 0;
    z-index: 7;
    pointer-events: none;
    background: radial-gradient(ellipse 80% 75% at 50% 52%, transparent 45%, rgba(2, 4, 8, 0.7) 100%);
  }

  .door-hit {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
    z-index: 11;
    background: transparent;
    border: 0;
    border-radius: 45% 45% 4px 4px / 22% 22% 4px 4px;
    cursor: pointer;
  }
  .door-hit:disabled { cursor: default; pointer-events: none; }
  .door-hit:focus-visible { outline: 2px solid rgba(255, 200, 130, 0.8); outline-offset: 6px; }

  .narrative {
    position: absolute;
    inset: 0;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 14px;
    padding: 11vh 8vw 0;
    text-align: center;
    pointer-events: none;
  }
  .narrative-line {
    margin: 0;
    font-size: clamp(15px, 2.3vw, 21px);
    line-height: 1.6;
    color: rgba(225, 233, 244, 0.9);
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.95), 0 0 4px rgba(0, 0, 0, 0.8);
    opacity: 0;
    transform: translateY(10px);
    animation: lineAppear 1.1s ease-out forwards;
  }
  .narrative-line--emphasis {
    font-size: clamp(17px, 2.8vw, 25px);
    font-weight: 600;
    color: rgba(245, 205, 145, 0.97);
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.95), 0 0 26px rgba(255, 170, 90, 0.25);
  }
  @keyframes lineAppear { to { opacity: 1; transform: translateY(0); } }
  .caption, .door-prompt {
    position: absolute;
    left: 0;
    right: 0;
    z-index: 10;
    margin: 0;
    padding: 0 6vw;
    text-align: center;
    pointer-events: none;
    opacity: 0;
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.95), 0 0 4px rgba(0, 0, 0, 0.8);
  }
  .caption {
    top: 7vh;
    font-size: clamp(15px, 2.3vw, 21px);
    color: rgba(225, 233, 244, 0.92);
  }
  .door-prompt {
    bottom: 6vh;
    font-size: clamp(11px, 1.5vw, 14px);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(250, 220, 175, 0.95);
  }

  .flash {
    position: absolute;
    inset: 0;
    z-index: 20;
    background: radial-gradient(circle at 50% 55%, #fff8ec 0%, #ffe6c2 45%, #ffcf96 100%);
    opacity: 0;
    pointer-events: none;
  }

  .ui-controls { position: absolute; right: 24px; bottom: 24px; z-index: 30; display: flex; gap: 12px; }
  .ui-btn {
    background: rgba(8, 12, 20, 0.6);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(160, 180, 210, 0.25);
    color: rgba(225, 233, 244, 0.85);
    padding: 10px 18px;
    border-radius: 6px;
    font: 600 11px 'Cinzel', serif;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.3s, border-color 0.3s;
  }
  .ui-btn:hover { background: rgba(8, 12, 20, 0.8); border-color: rgba(160, 180, 210, 0.5); }
  .ui-btn:focus-visible { outline: 2px solid rgba(255, 200, 130, 0.8); outline-offset: 2px; }
  .ui-btn-sound { padding: 10px 12px; }
  .sound-icon { display: block; }
  .sound-waves { opacity: 0.3; transition: opacity 0.3s; }
  .ui-btn-sound[aria-pressed='true'] .sound-waves { opacity: 1; }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 768px) {
    .narrative { gap: 12px; }
    .narrative-line { font-size: clamp(14px, 4vw, 17px); }
    .narrative-line--emphasis { font-size: clamp(16px, 4.6vw, 21px); }
    .door-prompt { bottom: 12vh; }
    .ui-controls { right: 16px; bottom: 16px; gap: 8px; }
    .ui-btn { padding: 8px 14px; font-size: 10px; }
  }
</style>

<script>
  import gsap from 'gsap';
  import { audioSystem } from '../../lib/audio-system';

  const byId = <T extends Element = HTMLElement>(id: string) => document.getElementById(id) as unknown as T;
  const root = byId('welcome-experience');
  const doorBtn = byId<HTMLButtonElement>('door-btn');
  const skipBtn = byId<HTMLButtonElement>('skip-btn');
  const soundBtn = byId<HTMLButtonElement>('sound-btn');
  const srAnnounce = byId('sr-announce');
  const video = byId<HTMLVideoElement>('door-video');
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

  type Pt = { x: number; y: number };
  const FAR: Pt = JSON.parse(root.dataset.far ?? '{}');
  const NEAR = JSON.parse(root.dataset.near ?? '{}') as {
    door: { x0: number; x1: number; y0: number; y1: number };
    lantern: Pt;
    windows: Pt[];
    sill: Pt;
  };
  const NEAR_POS = Number(root.dataset.nearPos ?? 0.5);
  const FAR_POS = Number(root.dataset.farPos ?? 0.5);
  const IMG_RATIO = 2752 / 1536;

  const announce = (message: string) => { if (srAnnounce) srAnnounce.textContent = message; };
  const redirectToSite = () => location.replace('/index/');
  const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
  const rand = (min: number, max: number) => min + Math.random() * (max - min);

  /** Ponto da imagem (frações) → pixels na tela, com object-fit: cover. */
  function mapPoint(p: Pt, posX: number): Pt {
    const W = innerWidth;
    const H = innerHeight;
    const rh = W / H > IMG_RATIO ? W / IMG_RATIO : H; // altura renderizada
    const rw = rh * IMG_RATIO;
    const offX = (W - rw) * posX;
    const offY = (H - rh) * 0.5;
    return { x: offX + p.x * rw, y: offY + p.y * rh };
  }

  function place(el: HTMLElement, p: Pt, posX: number) {
    const s = mapPoint(p, posX);
    el.style.left = `${s.x}px`;
    el.style.top = `${s.y}px`;
  }

  function layout() {
    place(byId('far-light'), FAR, FAR_POS);
    place(byId('glow-lantern'), NEAR.lantern, NEAR_POS);
    place(byId('glow-window-a'), NEAR.windows[0], NEAR_POS);
    place(byId('glow-window-b'), NEAR.windows[1], NEAR_POS);
    place(byId('glow-sill'), NEAR.sill, NEAR_POS);
    const a = mapPoint({ x: NEAR.door.x0, y: NEAR.door.y0 }, NEAR_POS);
    const b = mapPoint({ x: NEAR.door.x1, y: NEAR.door.y1 }, NEAR_POS);
    Object.assign(doorBtn.style, {
      left: `${a.x}px`,
      top: `${a.y}px`,
      width: `${b.x - a.x}px`,
      height: `${b.y - a.y}px`,
    });
    // A câmera se aproxima da porta distante.
    const far = mapPoint(FAR, FAR_POS);
    gsap.set('#plate-far', { transformOrigin: `${far.x}px ${far.y}px` });
    const door = mapPoint({ x: (NEAR.door.x0 + NEAR.door.x1) / 2, y: 0.55 }, NEAR_POS);
    gsap.set(['#plate-near', '#door-video'], { transformOrigin: `${door.x}px ${door.y}px` });
  }

  // ── Nevasca: duas camadas; `storm.wind` cresce a cada frase ─────
  const storm = { wind: 0.6, gust: 0, density: 1 };
  type Flake = { x: number; y: number; r: number; speed: number; drift: number; a: number; depth: number };
  const back = byId<HTMLCanvasElement>('snow-back');
  const front = byId<HTMLCanvasElement>('snow-front');
  const backCtx = back.getContext('2d');
  const frontCtx = front.getContext('2d');
  let backFlakes: Flake[] = [];
  let frontFlakes: Flake[] = [];

  function sizeCanvas(canvas: HTMLCanvasElement) {
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvas.width = innerWidth * dpr;
    canvas.height = innerHeight * dpr;
    canvas.getContext('2d')?.setTransform(dpr, 0, 0, dpr, 0, 0);
  }
  const flake = (depth: number): Flake => ({
    x: Math.random() * innerWidth,
    y: Math.random() * innerHeight,
    r: depth * rand(0.6, 1.3),
    speed: rand(0.6, 1.2) * depth,
    drift: rand(-0.3, 0.3),
    a: rand(0.3, 0.8) * Math.min(1, 0.55 + depth * 0.25),
    depth,
  });
  function seedSnow() {
    const area = innerWidth * innerHeight;
    backFlakes = Array.from({ length: Math.min(240, Math.floor(area / 6500)) }, () => flake(rand(0.6, 1.3)));
    frontFlakes = Array.from({ length: Math.min(60, Math.floor(area / 24000)) }, () => flake(rand(1.8, 3)));
  }
  function drawFlakes(ctx: CanvasRenderingContext2D, flakes: Flake[]) {
    ctx.clearRect(0, 0, innerWidth, innerHeight);
    const wind = storm.wind + storm.gust;
    ctx.strokeStyle = '#e8eef7';
    ctx.fillStyle = '#e8eef7';
    const visible = Math.round(flakes.length * storm.density);
    for (let i = 0; i < visible; i++) {
      const f = flakes[i];
      const vx = (f.drift + wind * 2.2) * f.depth;
      const vy = f.speed * (1 + wind * 0.6);
      f.x += vx;
      f.y += vy;
      if (f.y > innerHeight + 10) { f.y = -10; f.x = Math.random() * innerWidth; }
      if (f.x > innerWidth + 20) f.x = -20; else if (f.x < -20) f.x = innerWidth + 20;
      ctx.globalAlpha = f.a;
      if (wind > 1.4) {
        const k = Math.min(3.5, wind) * 1.4;
        ctx.lineWidth = f.r * 1.2;
        ctx.beginPath();
        ctx.moveTo(f.x, f.y);
        ctx.lineTo(f.x - vx * k, f.y - vy * k);
        ctx.stroke();
      } else {
        ctx.beginPath();
        ctx.arc(f.x, f.y, f.r, 0, Math.PI * 2);
        ctx.fill();
      }
    }
    ctx.globalAlpha = 1;
  }
  function frame() {
    if (backCtx) drawFlakes(backCtx, backFlakes);
    if (frontCtx) drawFlakes(frontCtx, frontFlakes);
    requestAnimationFrame(frame);
  }
  function resize() {
    sizeCanvas(back);
    sizeCanvas(front);
    seedSnow();
    layout();
  }
  function gusts() {
    gsap.to(storm, {
      gust: () => rand(0.4, 1.1) * Math.min(1, storm.wind / 1.5),
      duration: () => rand(0.6, 1.2),
      yoyo: true,
      repeat: -1,
      repeatDelay: 1.2,
      repeatRefresh: true,
      ease: 'sine.inOut',
    });
  }

  // ── A cena ───────────────────────────────────────────────────
  function buildScene(): gsap.core.Timeline {
    // Sem cor no início: a cena já é azul-acinzentada, então só o âmbar da porta some.
    gsap.set('#plate-far', { scale: 1.02, filter: 'brightness(0.72) saturate(0.08)' });
    gsap.set('#plate-near', { scale: 1.18, opacity: 0 });
    gsap.set(['#fog-a', '#fog-b'], { opacity: 0.5 });

    const tl = gsap.timeline({ paused: true });
    // 0–7 s: perdido na tempestade; o vento piora a cada frase.
    tl.to(storm, { wind: 2.6, duration: 7, ease: 'power1.in' }, 0)
      .to('#plate-far', { scale: 1.08, duration: 8.8, ease: 'none' }, 0)
      .to(['#fog-a', '#fog-b'], { opacity: 1, duration: 7 }, 0)
      .to('#darkness', { opacity: 0.45, duration: 7 }, 0)
      // 7.2 s: uma luz, lá longe.
      .to('#plate-far', { filter: 'brightness(0.8) saturate(1)', duration: 1.8, ease: 'sine.out' }, 7.2)
      .to('#far-light', { opacity: 1, duration: 1.6, ease: 'sine.out' }, 7.2)
      .to('#darkness', { opacity: 0.25, duration: 2.2 }, 7.4)
      .to('#narrative-text', { opacity: 0, y: -16, duration: 1, ease: 'power2.in' }, 8.8)
      // 9–12.4 s: você caminha até a luz.
      .to('#plate-far', { scale: 3.4, duration: 3.6, ease: 'power2.in' }, 9.0)
      .to('#plate-far', { filter: 'brightness(0.85) saturate(0.95) blur(3px)', duration: 3.6, ease: 'power2.in' }, 9.0)
      .to(storm, { wind: 1.4, duration: 3.6 }, 9.0)
      // 11.6 s: uma rajada de neve cobre a chegada...
      .to('#gust', { opacity: 1, duration: 0.8, ease: 'power2.in' }, 11.6)
      .set('#plate-far', { opacity: 0 }, 12.4)
      .set('#plate-near', { opacity: 1 }, 12.4)
      // ...e passa: a porta está à sua frente.
      .to('#gust', { opacity: 0, duration: 1.6, ease: 'power2.out' }, 12.4)
      .to('#plate-near', { scale: 1, duration: 3.2, ease: 'power2.out' }, 12.4)
      .to('#darkness', { opacity: 0.12, duration: 2 }, 12.4)
      .to(storm, { wind: 0.9, density: 0.7, duration: 3 }, 12.4)
      .to(['#fog-a', '#fog-b'], { opacity: 0.6, duration: 3 }, 12.4)
      .to('#caption', { opacity: 1, duration: 1 }, 13.0)
      .to('#caption', { opacity: 0, duration: 0.8 }, 15.6)
      .to('#door-prompt', { opacity: 1, duration: 1.2 }, 15.2);
    return tl;
  }

  /** Lanterna e janelas tremulando como fogo. */
  function idle() {
    gsap.to(['#glow-lantern', '#glow-window-a', '#glow-window-b', '#glow-sill'], {
      opacity: () => rand(0.45, 0.95),
      duration: () => rand(0.12, 0.4),
      repeat: -1,
      repeatRefresh: true,
      ease: 'sine.inOut',
    });
    gsap.to('#door-prompt', { opacity: 0.45, duration: 1.6, yoyo: true, repeat: -1, ease: 'sine.inOut', delay: 1 });
  }

  /** O vídeo da porta se abrindo; termina no clarão da lareira. */
  async function openDoor(): Promise<void> {
    gsap.killTweensOf(['#door-prompt']);
    gsap.to('#door-prompt', { opacity: 0, duration: 0.3 });
    gsap.to(storm, { wind: 0.5, density: 0.5, duration: 1.5 });
    gsap.to(['#glow-lantern', '#glow-window-a', '#glow-window-b', '#glow-sill'], { opacity: 0, duration: 0.4 });
    gsap.set('#door-video', { scale: gsap.getProperty('#plate-near', 'scale') });

    let played = false;
    try {
      video.currentTime = 0;
      await video.play();
      played = true;
    } catch {
      played = false;
    }

    if (played) {
      gsap.to('#door-video', { opacity: 1, duration: 0.25 });
      gsap.to('#plate-near', { opacity: 0, duration: 0.25, delay: 0.25 });
      // O vídeo tem ~5,9 s: a porta se abre por volta de 1,5 s e a luz cresce.
      await wait(4300);
      await gsap.to('#flash', { opacity: 1, duration: 1.3, ease: 'power2.in' });
    } else {
      // Sem vídeo (economia de dados, erro): só a luz da porta.
      await gsap.to('#flash', { opacity: 1, duration: 1.2, ease: 'power2.in' });
    }
  }

  async function runExperience() {
    resize();
    requestAnimationFrame(frame);
    gusts();
    announce('Um viajante perdido na nevasca. Ao longe, uma luz.');
    audioSystem.init();
    audioSystem.transitionTo('storm');

    const scene = buildScene();
    let opened = false;

    const open = async () => {
      if (opened) return;
      opened = true;
      doorBtn.disabled = true;
      if (scene.progress() < 1) scene.progress(1);
      if (!audioSystem.ready) audioSystem.init();
      audioSystem.setMuted(false, 600);
      audioSystem.transitionTo('door-open', 300);
      soundBtn?.setAttribute('aria-pressed', 'true');
      announce('Abrindo a porta...');
      if (reducedMotion) {
        redirectToSite();
        return;
      }
      await openDoor();
      audioSystem.transitionTo('tavern', 600);
      redirectToSite();
    };

    doorBtn.addEventListener('click', open);
    document.addEventListener('keydown', (event) => {
      if ((event.key === 'Enter' || event.key === ' ') && !doorBtn.disabled) {
        event.preventDefault();
        void open();
      }
    });

    scene.eventCallback('onComplete', () => {
      announce('Uma porta de taverna está à sua frente. Toque para entrar.');
      idle();
    });

    if (reducedMotion) {
      scene.progress(1);
      storm.wind = 0.5;
      doorBtn.disabled = false;
      return;
    }

    scene.play();
    // Já pode tocar na porta ao começar a se aproximar (pula para ela).
    await wait(9000);
    doorBtn.disabled = false;
  }

  skipBtn?.addEventListener('click', () => {
    audioSystem.init();
    audioSystem.transitionTo('tavern', 300);
    redirectToSite();
  });

  soundBtn?.addEventListener('click', () => {
    audioSystem.init();
    const muted = audioSystem.toggleMute();
    soundBtn.setAttribute('aria-pressed', String(!muted));
    soundBtn.setAttribute('aria-label', muted ? 'Ativar som' : 'Desativar som');
  });

  window.addEventListener('resize', resize);
  void runExperience();
</script>
