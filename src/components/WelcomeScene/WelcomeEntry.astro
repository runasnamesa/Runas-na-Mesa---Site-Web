---
/**
 * Welcome Experience V3 — Genshin Impact Inspired
 * Completamente reconstruído do zero
 */
---

<div id="welcome-experience" class="welcome-experience">
  <!-- Background Layer -->
  <div class="bg-layer">
    <div class="bg-mountains"></div>
    <div class="bg-overlay"></div>
  </div>

  <!-- Snow Particles -->
  <canvas id="snow-canvas" class="snow-canvas"></canvas>

  <!-- Main Door Scene -->
  <div class="door-scene" id="door-scene">
    <div class="narrative-container">
      <!-- Narrative Text -->
      <div class="narrative-text" id="narrative-text">
        <p class="narrative-line" style="animation-delay: 0s;">
          O vento uiva ao seu redor.
        </p>
        <p class="narrative-line" style="animation-delay: 1.5s;">
          A neve cega seus olhos.
        </p>
        <p class="narrative-line" style="animation-delay: 3s;">
          O frio penetra até os ossos.
        </p>
        <p class="narrative-line narrative-line--emphasis" style="animation-delay: 5s;">
          Então, na escuridão da tempestade...
        </p>
        <p class="narrative-line narrative-line--emphasis" style="animation-delay: 6.5s;">
          Uma luz surge à sua frente.
        </p>
        <p class="narrative-line narrative-line--emphasis" style="animation-delay: 8s;">
          Uma porta.
        </p>
      </div>

      <!-- Door Button -->
      <button class="door-button-simple" id="door-btn" aria-label="Abrir a porta e entrar">
        <span class="door-button-text">ABRIR A PORTA</span>
        <span class="door-button-glow"></span>
      </button>
    </div>
  </div>

  <!-- Light Transition Overlay -->
  <div class="light-transition" id="light-transition">
    <div class="light-burst" id="light-burst"></div>
  </div>

  <!-- UI Controls -->
  <div class="ui-controls">
    <button class="ui-btn ui-btn-skip" id="skip-btn">
      <span>PULAR</span>
    </button>
    <button class="ui-btn ui-btn-sound" id="sound-btn" aria-pressed="false">
      <svg class="sound-icon" width="20" height="20" viewBox="0 0 20 20">
        <path d="M10 4L6 8H3v4h3l4 4V4z" fill="currentColor"/>
        <path class="sound-waves" d="M13 7c1 1 1 5 0 6M15 5c2 2 2 8 0 10" stroke="currentColor" fill="none"/>
      </svg>
    </button>
  </div>

  <!-- Screen Reader -->
  <div class="sr-only" id="sr-announce" aria-live="polite" aria-atomic="true"></div>
</div>


<style>
  /* ═══════════════════════════════════════════════════════════
     RESET & BASE
     ═══════════════════════════════════════════════════════════ */
  :global(html), :global(body) {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #000;
  }

  .welcome-experience {
    position: fixed;
    inset: 0;
    background: #0a0e15;
    overflow: hidden;
    font-family: 'Cinzel', serif;
    z-index: 9999;
  }

  /* ═══════════════════════════════════════════════════════════
     BACKGROUND - Snowy Mountain
     ═══════════════════════════════════════════════════════════ */
  .bg-layer {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .bg-mountains {
    position: absolute;
    inset: 0;
    background: 
      linear-gradient(180deg, 
        rgba(10, 14, 21, 0.3) 0%, 
        rgba(10, 14, 21, 0.7) 50%,
        rgba(10, 14, 21, 0.95) 100%
      ),
      url('https://images.unsplash.com/photo-1519904981063-b0cf448d479e?w=1920&q=80') center/cover;
    filter: blur(2px) brightness(0.4) contrast(1.1);
  }

  .bg-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse at 50% 40%,
      transparent 0%,
      rgba(0, 0, 0, 0.4) 60%,
      rgba(0, 0, 0, 0.8) 100%
    );
  }

  /* ═══════════════════════════════════════════════════════════
     SNOW PARTICLES CANVAS
     ═══════════════════════════════════════════════════════════ */
  .snow-canvas {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  /* ═══════════════════════════════════════════════════════════
     DOOR SCENE - Narrative Experience
     ═══════════════════════════════════════════════════════════ */
  .door-scene {
    position: absolute;
    inset: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    animation: fadeInScene 2s ease-out 0.5s forwards;
  }

  @keyframes fadeInScene {
    to { opacity: 1; }
  }

  .narrative-container {
    max-width: 600px;
    width: 90%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 60px;
  }

  /* ───────────────────────────────────────────────────────────
     Narrative Text
     ─────────────────────────────────────────────────────────── */
  .narrative-text {
    display: flex;
    flex-direction: column;
    gap: 20px;
    text-align: center;
  }

  .narrative-line {
    font-size: clamp(16px, 2.5vw, 22px);
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.85);
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.9);
    opacity: 0;
    transform: translateY(10px);
    animation: lineAppear 1s ease-out forwards;
    margin: 0;
  }

  .narrative-line--emphasis {
    font-size: clamp(18px, 3vw, 26px);
    color: rgba(212, 176, 106, 0.95);
    font-weight: 600;
    text-shadow: 
      0 2px 20px rgba(0, 0, 0, 0.9),
      0 0 30px rgba(212, 176, 106, 0.3);
  }

  @keyframes lineAppear {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ───────────────────────────────────────────────────────────
     Simple Door Button
     ─────────────────────────────────────────────────────────── */
  .door-button-simple {
    position: relative;
    background: rgba(10, 14, 21, 0.7);
    backdrop-filter: blur(15px);
    border: 2px solid rgba(212, 176, 106, 0.5);
    color: rgba(212, 176, 106, 0.95);
    padding: 20px 50px;
    border-radius: 8px;
    font: 600 18px 'Cinzel', serif;
    letter-spacing: 3px;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    opacity: 0;
    transform: translateY(20px);
    animation: buttonAppear 1s ease-out 9s forwards;
    box-shadow: 
      0 10px 40px rgba(0, 0, 0, 0.6),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
  }

  @keyframes buttonAppear {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .door-button-simple:hover {
    background: rgba(212, 176, 106, 0.15);
    border-color: rgba(212, 176, 106, 0.8);
    transform: translateY(-3px);
    box-shadow: 
      0 15px 50px rgba(0, 0, 0, 0.7),
      0 0 40px rgba(212, 176, 106, 0.3),
      inset 0 1px 0 rgba(255, 255, 255, 0.2);
  }

  .door-button-simple:active {
    transform: translateY(-1px);
  }

  .door-button-simple:focus {
    outline: 2px solid rgba(212, 176, 106, 0.6);
    outline-offset: 4px;
  }

  .door-button-text {
    position: relative;
    z-index: 2;
  }

  .door-button-glow {
    position: absolute;
    inset: -2px;
    background: linear-gradient(
      45deg,
      transparent,
      rgba(212, 176, 106, 0.1),
      transparent
    );
    border-radius: 8px;
    opacity: 0;
    transition: opacity 0.4s;
    pointer-events: none;
  }

  .door-button-simple:hover .door-button-glow {
    opacity: 1;
    animation: glowSweep 2s ease-in-out infinite;
  }

  @keyframes glowSweep {
    0% {
      background-position: -200% center;
    }
    100% {
      background-position: 200% center;
    }
  }

  /* ═══════════════════════════════════════════════════════════
     TAVERN SCENE
     ═══════════════════════════════════════════════════════════ */
  .tavern-scene {
    position: absolute;
    inset: 0;
    z-index: 5;
    opacity: 0;
    pointer-events: none;
    transition: opacity 2s ease;
  }

  .tavern-scene.visible {
    opacity: 1;
    pointer-events: auto;
  }

  .tavern-bg {
    position: absolute;
    inset: 0;
    background: 
      radial-gradient(ellipse at 50% 40%, 
        #4d2812 0%, 
        #2a1508 40%, 
        #1a0d05 70%, 
        #0d0604 100%
      );
  }

  /* Fireplace */
  .fireplace {
    position: absolute;
    left: 50%;
    top: 35%;
    transform: translateX(-50%);
    width: min(280px, 35vw);
    height: min(320px, 40vh);
    background: 
      radial-gradient(ellipse at 50% 95%, 
        #fff5b0 0%, 
        #ff9020 8%, 
        #992a0a 22%, 
        #0d0604 45%
      );
    border: 18px solid #2a1f1a;
    border-bottom-width: 12px;
    border-radius: 50% 50% 0 0 / 60% 60% 0 0;
    box-shadow: 
      0 0 60px rgba(255, 120, 40, 0.4),
      inset 0 0 40px rgba(0, 0, 0, 0.8);
  }

  .fire-container {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .fire-flame {
    position: absolute;
    bottom: 10%;
    width: 18%;
    border-radius: 50%;
    background: linear-gradient(0deg, #ffeb80 0%, #ff7420 60%, transparent 100%);
    filter: blur(2px);
    animation: flameFlicker 1.5s ease-in-out infinite alternate;
  }

  .fire-flame-1 {
    left: 42%;
    height: 50%;
    animation-duration: 1.3s;
  }

  .fire-flame-2 {
    left: 28%;
    height: 35%;
    animation-duration: 1.7s;
    animation-delay: -0.5s;
  }

  .fire-flame-3 {
    left: 58%;
    height: 42%;
    animation-duration: 1.5s;
    animation-delay: -1s;
  }

  @keyframes flameFlicker {
    0% { transform: scaleX(0.9) scaleY(1) rotate(-2deg); }
    100% { transform: scaleX(1.1) scaleY(1.08) rotate(3deg); }
  }

  .fire-glow-effect {
    position: absolute;
    inset: -50%;
    background: radial-gradient(
      ellipse,
      rgba(255, 140, 60, 0.2) 0%,
      transparent 60%
    );
    filter: blur(40px);
    animation: fireGlow 2s ease-in-out infinite alternate;
  }

  @keyframes fireGlow {
    0% { opacity: 0.5; }
    100% { opacity: 1; }
  }

  /* Windows */
  .window {
    position: absolute;
    top: 12%;
    width: 140px;
    height: 180px;
    background: linear-gradient(180deg, #1c2838 0%, #0e1522 100%);
    border: 8px solid #2a1f1a;
    border-radius: 20px 20px 0 0;
    box-shadow: inset 0 0 20px rgba(0, 0, 0, 0.5);
  }

  .window-left { left: 8%; }
  .window-right { right: 8%; }

  .moon {
    position: absolute;
    top: 20%;
    right: 25%;
    width: 55px;
    height: 55px;
    background: radial-gradient(circle at 35% 30%, #f0f4f8 0%, #c8d0d8 60%, #a0b0c0 100%);
    border-radius: 50%;
    box-shadow: 0 0 20px rgba(240, 244, 248, 0.4);
  }

  /* Furniture */
  .table {
    position: absolute;
    left: 50%;
    bottom: 0;
    transform: translateX(-50%) perspective(600px) rotateX(60deg);
    width: min(800px, 80vw);
    height: 35%;
    background: repeating-linear-gradient(
      90deg,
      #2a1508 0,
      #2a1508 15%,
      #1a0d05 15%,
      #1a0d05 17%,
      #3a1e0a 17%,
      #3a1e0a 30%
    );
    border: 8px solid #1a0d05;
    box-shadow: 0 -10px 40px rgba(0, 0, 0, 0.6);
  }

  .shelf {
    position: absolute;
    top: 22%;
    width: 160px;
    height: 200px;
    background: 
      linear-gradient(180deg, #1a0d05 0 10%, transparent 10% 90%, #1a0d05 90%),
      repeating-linear-gradient(90deg, #3a1e0a 0 12%, #1a0d05 12% 14%);
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.5);
  }

  .shelf-left { left: 5%; }
  .shelf-right { right: 5%; }

  /* Dust Particles */
  .dust-canvas {
    position: absolute;
    inset: 0;
    opacity: 0.12;
    pointer-events: none;
  }

  /* ═══════════════════════════════════════════════════════════
     LIGHT TRANSITION OVERLAY
     ═══════════════════════════════════════════════════════════ */
  .light-transition {
    position: absolute;
    inset: 0;
    z-index: 20;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s ease;
  }

  .light-transition.active {
    opacity: 1;
  }

  .light-burst {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 100vmax;
    height: 100vmax;
    transform: translate(-50%, -50%) scale(0);
    background: radial-gradient(
      circle,
      rgba(255, 240, 200, 1) 0%,
      rgba(255, 200, 120, 0.9) 15%,
      rgba(255, 160, 80, 0.6) 30%,
      rgba(200, 100, 40, 0.3) 50%,
      transparent 70%
    );
    filter: blur(20px);
  }

  .light-burst.expanding {
    animation: burstExpand 2.5s cubic-bezier(0.25, 0.8, 0.25, 1) forwards;
  }

  @keyframes burstExpand {
    0% { transform: translate(-50%, -50%) scale(0); opacity: 0; }
    20% { opacity: 1; }
    100% { transform: translate(-50%, -50%) scale(3); opacity: 1; }
  }

  .light-burst.fading {
    animation: burstFade 1.5s ease-out forwards;
  }

  @keyframes burstFade {
    to { opacity: 0; }
  }

  /* ═══════════════════════════════════════════════════════════
     UI CONTROLS
     ═══════════════════════════════════════════════════════════ */
  .ui-controls {
    position: absolute;
    right: 24px;
    bottom: 24px;
    z-index: 30;
    display: flex;
    gap: 12px;
  }

  .ui-btn {
    background: rgba(10, 14, 21, 0.6);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(212, 176, 106, 0.3);
    color: rgba(255, 255, 255, 0.85);
    padding: 10px 18px;
    border-radius: 6px;
    font: 600 11px 'Cinzel', serif;
    letter-spacing: 1.5px;
    cursor: pointer;
    transition: all 0.3s ease;
    text-transform: uppercase;
  }

  .ui-btn:hover {
    background: rgba(10, 14, 21, 0.8);
    border-color: rgba(212, 176, 106, 0.6);
    box-shadow: 0 0 20px rgba(212, 176, 106, 0.3);
    transform: translateY(-2px);
  }

  .ui-btn-sound {
    padding: 10px 12px;
  }

  .sound-icon {
    display: block;
  }

  .sound-waves {
    opacity: 0.3;
    transition: opacity 0.3s;
  }

  .ui-btn-sound[aria-pressed="true"] .sound-waves {
    opacity: 1;
  }

  /* Screen Reader */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .narrative-container {
      width: 85%;
      gap: 40px;
    }

    .narrative-line {
      font-size: clamp(14px, 4vw, 18px);
    }

    .narrative-line--emphasis {
      font-size: clamp(16px, 4.5vw, 22px);
    }

    .door-button-simple {
      padding: 16px 40px;
      font-size: 15px;
      letter-spacing: 2px;
    }

    .ui-controls {
      right: 16px;
      bottom: 16px;
      gap: 8px;
    }

    .ui-btn {
      padding: 8px 14px;
      font-size: 10px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    * {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>


<script>
  import gsap from 'gsap';
  import { audioSystem } from '../../lib/audio-system';

  // DOM Elements
  const doorBtn = document.getElementById('door-btn');
  const lightTransition = document.getElementById('light-transition');
  const lightBurst = document.getElementById('light-burst');
  const skipBtn = document.getElementById('skip-btn');
  const soundBtn = document.getElementById('sound-btn');
  const srAnnounce = document.getElementById('sr-announce');

  // Reduced motion check
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Snow Particles System
  class SnowSystem {
    canvas: HTMLCanvasElement;
    ctx: CanvasRenderingContext2D | null;
    particles: Array<{x: number; y: number; radius: number; speedY: number; speedX: number; opacity: number}>;
    width: number;
    height: number;

    constructor(canvas: HTMLCanvasElement) {
      this.canvas = canvas;
      this.ctx = canvas.getContext('2d');
      this.particles = [];
      this.width = 0;
      this.height = 0;
      this.resize();
      this.init();
    }

    resize() {
      this.width = window.innerWidth;
      this.height = window.innerHeight;
      this.canvas.width = this.width;
      this.canvas.height = this.height;
    }

    init() {
      const count = Math.min(150, Math.floor(this.width / 10));
      for (let i = 0; i < count; i++) {
        this.particles.push({
          x: Math.random() * this.width,
          y: Math.random() * this.height,
          radius: Math.random() * 2 + 0.5,
          speedY: Math.random() * 0.5 + 0.2,
          speedX: Math.random() * 0.3 - 0.15,
          opacity: Math.random() * 0.5 + 0.3
        });
      }
    }

    update() {
      if (!this.ctx) return;
      this.ctx.clearRect(0, 0, this.width, this.height);
      
      for (const p of this.particles) {
        p.y += p.speedY;
        p.x += p.speedX;

        if (p.y > this.height) {
          p.y = -10;
          p.x = Math.random() * this.width;
        }
        if (p.x > this.width) p.x = 0;
        if (p.x < 0) p.x = this.width;

        this.ctx.beginPath();
        this.ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
        this.ctx.fillStyle = `rgba(255, 255, 255, ${p.opacity})`;
        this.ctx.fill();
      }
    }

    animate() {
      this.update();
      requestAnimationFrame(() => this.animate());
    }

    stop() {
      gsap.to(this.canvas, { opacity: 0, duration: 2 });
    }
  }

  // Initialize snow
  const snowCanvas = document.getElementById('snow-canvas') as HTMLCanvasElement;
  if (!snowCanvas) throw new Error('Snow canvas not found');
  const snow = new SnowSystem(snowCanvas);
  snow.animate();

  // Announce for screen readers
  const announce = (message: string) => {
    if (srAnnounce) srAnnounce.textContent = message;
  };

  // Redirect to main site
  const redirectToSite = () => {
    location.replace('/index/');
  };

  // Main sequence
  const runExperience = async () => {
    if (reducedMotion) {
      // Fast forward for reduced motion
      audioSystem.init();
      audioSystem.transitionTo('tavern', 300);
      await new Promise(resolve => setTimeout(resolve, 500));
      redirectToSite();
      return;
    }

    announce('Tempestade de neve. Uma porta misteriosa aparece.');

    // Initialize audio with tavern music
    audioSystem.init();
    audioSystem.transitionTo('tavern');

    // Wait a bit before allowing interaction
    await new Promise(resolve => setTimeout(resolve, 2000));

    // Door is now interactive
    announce('Clique na porta para abrir');

    // Wait for door click
    await new Promise<void>((resolve) => {
      const handleDoorClick = (e: Event) => {
        e.preventDefault();
        doorBtn?.removeEventListener('click', handleDoorClick);
        document.removeEventListener('keydown', handleKeydown);
        
        // Enable audio on interaction if not ready
        if (!audioSystem.ready) {
          audioSystem.init();
          audioSystem.transitionTo('tavern');
        }
        audioSystem.setMuted(false, 600);
        soundBtn?.setAttribute('aria-pressed', 'true');
        
        resolve();
      };

      const handleKeydown = (e: KeyboardEvent) => {
        if (e.key === 'Enter' || e.key === ' ') {
          handleDoorClick(e);
        }
      };

      doorBtn?.addEventListener('click', handleDoorClick);
      document.addEventListener('keydown', handleKeydown);
    });

    announce('Abrindo a porta...');

    // Fade out narrative text and button
    gsap.to('.narrative-text', { opacity: 0, duration: 0.8 });
    gsap.to('.door-button-simple', { opacity: 0, duration: 0.8 });

    await new Promise(resolve => setTimeout(resolve, 500));

    // Light burst transition
    lightTransition?.classList.add('active');
    lightBurst?.classList.add('expanding');
    
    // Fade out snow
    snow.stop();

    await new Promise(resolve => setTimeout(resolve, 2500));

    // Redirect to main site
    redirectToSite();
  };

  // Skip button handler
  skipBtn?.addEventListener('click', () => {
    audioSystem.init();
    audioSystem.transitionTo('tavern', 300);
    redirectToSite();
  });

  // Sound toggle handler
  soundBtn?.addEventListener('click', () => {
    audioSystem.init();
    const muted = audioSystem.toggleMute();
    soundBtn.setAttribute('aria-pressed', String(!muted));
    soundBtn.setAttribute('aria-label', muted ? 'Ativar som' : 'Desativar som');
  });

  // Handle window resize
  window.addEventListener('resize', () => {
    snow.resize();
  });

  // Start the experience
  runExperience();
</script>
