---
/**
 * Abertura da Taverna — inspirada na tela de entrada de Genshin Impact
 * (Celestia Door): a porta não existe e, de repente, se MONTA a partir de
 * fragmentos que brotam do chão e se encaixam de baixo para cima. Aqui ela é
 * a porta dupla de uma taverna medieval: tábuas de madeira, ferragens
 * rebitadas, argolas, arco e batentes de pedra com neve. Ao tocar, as folhas
 * se entreabrem e a luz quente da lareira inunda a tela — e a taverna
 * (/index/) aparece.
 *
 * SVG + GSAP + canvas 2D (sem WebGL): leve e fluido no celular. A geometria
 * da porta é calculada aqui no build; cada pedra, tábua e ferragem é uma
 * peça (`.piece`) animada no cliente.
 */

// viewBox 300 × 480. Vão da porta: x 60–240, arco com centro (150, 200).
const CX = 150;
const SPRING = 200;
const R_IN = 90;
const R_OUT = 117;
const BOTTOM = 450;

const polar = (r: number, a: number) => [CX + r * Math.cos(a), SPRING - r * Math.sin(a)].map((n) => n.toFixed(2)).join(' ');

// Aduelas do arco (9), com a chave central maior.
const VOUSSOIRS = 9;
const gap = 0.012;
const voussoirs = Array.from({ length: VOUSSOIRS }, (_, i) => {
  const a0 = Math.PI - (i * Math.PI) / VOUSSOIRS - gap;
  const a1 = Math.PI - ((i + 1) * Math.PI) / VOUSSOIRS + gap;
  const key = i === Math.floor(VOUSSOIRS / 2);
  const outer = key ? R_OUT + 14 : R_OUT;
  const d = `M${polar(outer, a0)} A${outer} ${outer} 0 0 1 ${polar(outer, a1)} L${polar(R_IN, a1)} A${R_IN} ${R_IN} 0 0 0 ${polar(R_IN, a0)} Z`;
  return { d, key, order: Math.min(i, VOUSSOIRS - 1 - i) };
});

// Batentes: 5 pedras de cada lado, alternando largura (cunhais).
const jambs = Array.from({ length: 5 }, (_, i) => {
  const y1 = BOTTOM - i * 50;
  const y0 = y1 - 50 + 1.5;
  const outer = i % 2 === 0 ? 30 : 38;
  return [
    { x: outer, y: y0, w: 60 - outer - 1, h: 48.5, order: i },
    { x: 241, y: y0, w: 300 - outer - 241, h: 48.5, order: i },
  ];
}).flat();

// Tábuas: 3 por folha, cortadas pelo arco (clipPath das folhas).
const planks = [60, 90, 120, 150, 180, 210].map((x, i) => ({
  x: x + 0.6,
  w: 28.8,
  left: i < 3,
  // veios ondulados (desenho fixo por tábua, para não mudar a cada build)
  grain: [0.25, 0.55, 0.8].map((f, k) => {
    const gx = x + 30 * f;
    const wave = 2 + ((i + k) % 3);
    return `M${gx} 100 C${gx + wave} 180 ${gx - wave} 260 ${gx + wave / 2} 330 S${gx - wave} 420 ${gx} 452`;
  }),
}));

// Ferragens (dobradiças compridas) e rebites.
const straps = [218, 392].flatMap((y) => [
  { y, x0: 60, x1: 136, left: true },
  { y, x0: 164, x1: 240, left: false },
]);
// Neve assentada sobre o arco: dois trechos (a chave do arco fica de fora).
const snowArc = (from: number, to: number) => {
  const steps = 14;
  const top: string[] = [];
  const bottom: string[] = [];
  for (let k = 0; k <= steps; k++) {
    const a = ((from + ((to - from) * k) / steps) * Math.PI) / 180;
    const bump = 3 + 2.5 * Math.abs(Math.sin(k * 1.7));
    top.push(polar(R_OUT + bump, a));
    bottom.unshift(polar(R_OUT - 1.5, a));
  }
  return `M${top.join(" L")} L${bottom.join(" L")} Z`;
};
const snowCaps = [snowArc(162, 101), snowArc(79, 18)];

const rivets = straps.flatMap((s) =>
  Array.from({ length: 5 }, (_, k) => ({ x: s.left ? s.x0 + 10 + k * 15 : s.x1 - 10 - k * 15, y: s.y, left: s.left })),
);
---

<div id="welcome-experience" class="welcome-experience">
  <div class="bg-layer">
    <div class="bg-mountains"></div>
    <div class="bg-overlay"></div>
  </div>

  <canvas id="snow-canvas" class="fx-canvas fx-canvas--snow"></canvas>

  <div class="door-stage" aria-hidden="true">
    <div class="door-float" id="door-float">
      <div class="door-floor" id="door-floor"></div>
      <div class="door-halo" id="door-halo"></div>
      <div class="door-inner-light" id="door-inner-light"></div>

      <!-- Folhas (camadas próprias para abrirem em 3D). -->
      {[true, false].map((left) => (
        <div class={`door-leaf ${left ? 'door-leaf--left' : 'door-leaf--right'}`} id={left ? 'leaf-left' : 'leaf-right'}>
          <svg viewBox="0 0 300 480" class="door-svg">
            <g clip-path={`url(#${left ? 'clip-left' : 'clip-right'})`}>
              {planks.filter((p) => p.left === left).map((p) => (
                <g class="piece plank">
                  <rect x={p.x} y="100" width={p.w} height="352" fill="url(#wood)" />
                  <g fill="none" stroke="#2a170c" stroke-width="1.1" opacity="0.45">
                    {p.grain.map((d) => <path d={d} />)}
                  </g>
                  <rect x={p.x} y="100" width="2.2" height="352" fill="#7a4a2a" opacity="0.5" />
                </g>
              ))}
            </g>
            {straps.filter((s) => s.left === left).map((s) => (
              <g class="piece iron">
                <rect x={s.x0} y={s.y - 7} width={s.x1 - s.x0} height="14" rx="3" fill="url(#iron)" />
                <circle cx={s.left ? s.x1 : s.x0} cy={s.y} r="9" fill="url(#iron)" />
                {rivets.filter((r) => r.left === left && r.y === s.y).map((r) => (
                  <circle cx={r.x} cy={r.y} r="2.4" fill="#8d8a82" stroke="#1b1b1a" stroke-width="0.6" />
                ))}
              </g>
            ))}
            <g class="piece handle">
              <circle cx={left ? 140 : 160} cy="300" r="7" fill="url(#iron)" />
              <circle class="ring" cx={left ? 140 : 160} cy="313" r="11" fill="none" stroke="#3a3936" stroke-width="3.4" />
            </g>
          </svg>
        </div>
      ))}

      <div class="door-seam" id="door-seam"></div>
      <div class="door-sill-light" id="door-sill-light"></div>

      <!-- Moldura de pedra (na frente das folhas). -->
      <svg viewBox="0 0 300 480" class="door-svg door-frame" id="door-frame">
        <defs>
          <linearGradient id="wood" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#4b2a17" />
            <stop offset="0.45" stop-color="#6a3d22" />
            <stop offset="1" stop-color="#3f2313" />
          </linearGradient>
          <linearGradient id="iron" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#5c5a55" />
            <stop offset="0.5" stop-color="#34332f" />
            <stop offset="1" stop-color="#1d1c1a" />
          </linearGradient>
          <linearGradient id="stone" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#8a857c" />
            <stop offset="1" stop-color="#55514b" />
          </linearGradient>
          <clipPath id="clip-left"><path d="M60 452 L60 200 A90 90 0 0 1 150 110 L150 452 Z" /></clipPath>
          <clipPath id="clip-right"><path d="M240 452 L240 200 A90 90 0 0 0 150 110 L150 452 Z" /></clipPath>
          <!-- Silhueta da porta em unidades da própria caixa (brilho que passa). -->
          <clipPath id="door-silhouette" clipPathUnits="objectBoundingBox">
            <path d="M0.1 0.98 L0.1 0.42 A0.4 0.25 0 0 1 0.9 0.42 L0.9 0.98 Z" />
          </clipPath>
        </defs>

        <!-- Soleira -->
        {[[18, 104], [104, 196], [196, 282]].map(([x0, x1]) => (
          <g class="piece stone sill">
            <rect x={x0 + 0.8} y="451" width={x1 - x0 - 1.6} height="20" rx="2" fill="url(#stone)" stroke="#3c3934" stroke-width="1" />
            <rect x={x0 + 2} y="451" width={x1 - x0 - 4} height="3" fill="#a9a398" opacity="0.6" />
          </g>
        ))}
        <!-- Batentes -->
        {jambs.map((j) => (
          <g class="piece stone jamb" data-order={j.order}>
            <rect x={j.x} y={j.y} width={j.w} height={j.h} rx="2" fill="url(#stone)" stroke="#3c3934" stroke-width="1" />
            <rect x={j.x + 1.5} y={j.y + 1.5} width={j.w - 3} height="3" fill="#a9a398" opacity="0.5" />
          </g>
        ))}
        <!-- Arco -->
        {voussoirs.map((v) => (
          <path
            class={`piece stone voussoir ${v.key ? 'keystone' : ''}`}
            data-order={v.order}
            d={v.d}
            fill="url(#stone)"
            stroke="#3c3934"
            stroke-width="1"
          />
        ))}
        <!-- Neve acumulada (aparece depois da montagem) -->
        <g class="snow-cap" fill="#f3f6fb">
          {snowCaps.map((d) => <path d={d} opacity="0.95" />)}
          <path d="M136 69 Q150 62 164 69 L164 72 L136 72 Z" opacity="0.95" />
          <path d="M16 452 C40 444 80 446 104 449 C130 444 170 444 196 449 C222 445 262 444 284 452 L284 455 L16 455 Z" opacity="0.85" />
        </g>
      </svg>

      <div class="door-glint" id="door-glint"></div>
    </div>
  </div>

  <canvas id="fx-canvas" class="fx-canvas fx-canvas--fx"></canvas>

  <div class="narrative" id="narrative-text">
    <p class="narrative-line" style="animation-delay: 0.5s;">O vento uiva ao seu redor.</p>
    <p class="narrative-line" style="animation-delay: 2s;">A neve cega seus olhos.</p>
    <p class="narrative-line" style="animation-delay: 3.5s;">O frio penetra até os ossos.</p>
    <p class="narrative-line narrative-line--emphasis" style="animation-delay: 5s;">Então, na escuridão da tempestade...</p>
    <p class="narrative-line narrative-line--emphasis" style="animation-delay: 6.5s;">Uma luz surge à sua frente.</p>
  </div>

  <!-- Toda a porta é o botão (área de toque grande no celular). -->
  <button class="door-hit" id="door-btn" type="button" aria-label="Abrir a porta e entrar na taverna" disabled></button>
  <p class="door-prompt" id="door-prompt" aria-hidden="true">Toque na porta para entrar</p>

  <div class="flash" id="flash"></div>

  <div class="ui-controls">
    <button class="ui-btn" id="skip-btn" type="button">Pular</button>
    <button class="ui-btn ui-btn-sound" id="sound-btn" type="button" aria-pressed="false" aria-label="Ativar som">
      <svg class="sound-icon" width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
        <path d="M10 4L6 8H3v4h3l4 4V4z" fill="currentColor" />
        <path class="sound-waves" d="M13 7c1 1 1 5 0 6M15 5c2 2 2 8 0 10" stroke="currentColor" fill="none" />
      </svg>
    </button>
  </div>

  <div class="sr-only" id="sr-announce" aria-live="polite" aria-atomic="true"></div>
</div>

<style>
  :global(html), :global(body) {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #000;
  }

  .welcome-experience {
    position: fixed;
    inset: 0;
    background: #0a0e15;
    overflow: hidden;
    font-family: 'Cinzel', serif;
    z-index: 9999;
    --door-h: min(64vh, 560px);
    --door-w: calc(var(--door-h) * 0.625);
  }

  .bg-layer { position: absolute; inset: 0; z-index: 1; }
  .bg-mountains {
    position: absolute;
    inset: -20px;
    background:
      linear-gradient(180deg, rgba(10, 14, 21, 0.3) 0%, rgba(10, 14, 21, 0.7) 50%, rgba(10, 14, 21, 0.95) 100%),
      url('https://images.unsplash.com/photo-1519904981063-b0cf448d479e?w=1920&q=80') center/cover;
    filter: blur(2px) brightness(0.4) contrast(1.1);
  }
  .bg-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 50% 45%, transparent 0%, rgba(0, 0, 0, 0.45) 60%, rgba(0, 0, 0, 0.85) 100%);
  }

  .fx-canvas { position: absolute; inset: 0; pointer-events: none; }
  .fx-canvas--snow { z-index: 2; }
  .fx-canvas--fx { z-index: 7; }

  /* Porta */
  .door-stage {
    position: absolute;
    inset: 0;
    z-index: 5;
    display: grid;
    place-items: center;
    perspective: 1200px;
    pointer-events: none;
  }
  .door-float {
    position: relative;
    width: var(--door-w);
    height: var(--door-h);
    transform-style: preserve-3d;
  }
  .door-svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .door-floor {
    position: absolute;
    left: 50%;
    bottom: -7%;
    width: 210%;
    height: 24%;
    transform: translateX(-50%);
    background: radial-gradient(ellipse at center, rgba(255, 190, 110, 0.4) 0%, rgba(230, 140, 60, 0.14) 40%, transparent 70%);
    opacity: 0;
  }
  .door-halo {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 240%;
    height: 160%;
    transform: translate(-50%, -50%);
    background: radial-gradient(ellipse at center, rgba(255, 200, 120, 0.22) 0%, rgba(230, 150, 70, 0.08) 40%, transparent 68%);
    opacity: 0;
  }
  .door-inner-light {
    position: absolute;
    left: 20%;
    right: 20%;
    top: 23%;
    bottom: 5.8%;
    border-radius: 50% 50% 0 0 / 34% 34% 0 0;
    background: radial-gradient(ellipse at 50% 60%, #fffaf0 0%, #ffe2a8 30%, #ffb45a 65%, #c8641e 100%);
    box-shadow: 0 0 90px 30px rgba(255, 190, 110, 0.55);
    /* Atrás do giro das folhas (que entram na casa): senão as cobre em 3D. */
    transform: translateZ(-70px) scale(1.06);
    opacity: 0;
  }
  .door-leaf {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    will-change: transform;
  }
  /* Dobradiças: x = 60 e 240 de 300. */
  .door-leaf--left { transform-origin: 20% 50%; }
  .door-leaf--right { transform-origin: 80% 50%; }
  .door-seam {
    position: absolute;
    left: 50%;
    top: 23.5%;
    bottom: 6%;
    width: 2px;
    margin-left: -1px;
    background: linear-gradient(180deg, transparent, #ffd38a 12%, #ffe6b8 50%, #ffd38a 88%, transparent);
    box-shadow: 0 0 10px 2px rgba(255, 190, 100, 0.8);
    opacity: 0;
  }
  .door-sill-light {
    position: absolute;
    left: 20%;
    right: 20%;
    bottom: 5.6%;
    height: 3px;
    background: linear-gradient(90deg, transparent, #ffcf85 15%, #ffe2ae 50%, #ffcf85 85%, transparent);
    box-shadow: 0 0 14px 4px rgba(255, 180, 90, 0.7);
    opacity: 0;
  }
  .door-glint {
    position: absolute;
    left: 6%;
    right: 6%;
    top: 16%;
    bottom: 1%;
    clip-path: url(#door-silhouette);
    background: linear-gradient(105deg, transparent 35%, rgba(255, 245, 220, 0.55) 48%, rgba(255, 255, 255, 0.85) 50%, rgba(255, 245, 220, 0.55) 52%, transparent 65%);
    background-size: 300% 100%;
    background-position: 120% 0;
    mix-blend-mode: screen;
    opacity: 0;
    pointer-events: none;
  }
  .door-frame .piece, .door-leaf .piece { transform-box: fill-box; transform-origin: 50% 100%; }
  .snow-cap { opacity: 0; }

  .door-hit {
    position: absolute;
    left: 50%;
    top: 50%;
    width: var(--door-w);
    height: var(--door-h);
    transform: translate(-50%, -50%);
    z-index: 9;
    background: transparent;
    border: 0;
    border-radius: 45% 45% 4px 4px / 28% 28% 4px 4px;
    cursor: pointer;
  }
  .door-hit:disabled { cursor: default; }
  .door-hit:focus-visible { outline: 2px solid rgba(255, 210, 140, 0.9); outline-offset: 8px; }
  .door-prompt {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(50% + var(--door-h) / 2 + 18px);
    z-index: 9;
    margin: 0;
    text-align: center;
    font-size: clamp(12px, 1.6vw, 15px);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(255, 228, 184, 0.92);
    text-shadow: 0 0 18px rgba(255, 180, 90, 0.6), 0 2px 10px rgba(0, 0, 0, 0.9);
    opacity: 0;
    pointer-events: none;
  }

  .narrative {
    position: absolute;
    inset: 0;
    z-index: 8;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 18px;
    padding: 0 8vw;
    text-align: center;
    pointer-events: none;
  }
  .narrative-line {
    margin: 0;
    font-size: clamp(16px, 2.5vw, 22px);
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.88);
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.9);
    opacity: 0;
    transform: translateY(10px);
    animation: lineAppear 1s ease-out forwards;
  }
  .narrative-line--emphasis {
    font-size: clamp(18px, 3vw, 26px);
    font-weight: 600;
    color: rgba(232, 196, 120, 0.97);
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.9), 0 0 30px rgba(212, 176, 106, 0.35);
  }
  @keyframes lineAppear { to { opacity: 1; transform: translateY(0); } }

  .flash {
    position: absolute;
    inset: 0;
    z-index: 20;
    background: radial-gradient(circle at 50% 50%, #fffdf7 0%, #fff0d4 45%, #ffd9a0 100%);
    opacity: 0;
    pointer-events: none;
  }

  .ui-controls {
    position: absolute;
    right: 24px;
    bottom: 24px;
    z-index: 30;
    display: flex;
    gap: 12px;
  }
  .ui-btn {
    background: rgba(10, 14, 21, 0.6);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(212, 176, 106, 0.3);
    color: rgba(255, 255, 255, 0.85);
    padding: 10px 18px;
    border-radius: 6px;
    font: 600 11px 'Cinzel', serif;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.3s, border-color 0.3s, box-shadow 0.3s;
  }
  .ui-btn:hover {
    background: rgba(10, 14, 21, 0.8);
    border-color: rgba(212, 176, 106, 0.6);
    box-shadow: 0 0 20px rgba(212, 176, 106, 0.3);
  }
  .ui-btn:focus-visible { outline: 2px solid rgba(255, 210, 140, 0.9); outline-offset: 2px; }
  .ui-btn-sound { padding: 10px 12px; }
  .sound-icon { display: block; }
  .sound-waves { opacity: 0.3; transition: opacity 0.3s; }
  .ui-btn-sound[aria-pressed='true'] .sound-waves { opacity: 1; }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 768px) {
    .welcome-experience { --door-h: min(56vh, 470px); }
    .narrative { gap: 14px; }
    .narrative-line { font-size: clamp(14px, 4vw, 18px); }
    .narrative-line--emphasis { font-size: clamp(16px, 4.5vw, 22px); }
    .ui-controls { right: 16px; bottom: 16px; gap: 8px; }
    .ui-btn { padding: 8px 14px; font-size: 10px; }
  }
</style>

<script>
  import gsap from 'gsap';
  import { audioSystem } from '../../lib/audio-system';

  const byId = <T extends Element = HTMLElement>(id: string) => document.getElementById(id) as unknown as T;
  const doorBtn = byId<HTMLButtonElement>('door-btn');
  const skipBtn = byId<HTMLButtonElement>('skip-btn');
  const soundBtn = byId<HTMLButtonElement>('sound-btn');
  const srAnnounce = byId('sr-announce');
  const frameSvg = byId<SVGSVGElement>('door-frame');
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

  const announce = (message: string) => { if (srAnnounce) srAnnounce.textContent = message; };
  const redirectToSite = () => location.replace('/index/');
  const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
  const rand = (min: number, max: number) => min + Math.random() * (max - min);

  // ── Canvas: neve de fundo + partículas da montagem ────────────
  const snowCanvas = byId<HTMLCanvasElement>('snow-canvas');
  const fxCanvas = byId<HTMLCanvasElement>('fx-canvas');
  const snowCtx = snowCanvas.getContext('2d');
  const fxCtx = fxCanvas.getContext('2d');

  type Flake = { x: number; y: number; r: number; vy: number; vx: number; a: number };
  type Bit = { x: number; y: number; vx: number; vy: number; life: number; max: number; size: number; ember: boolean };
  let flakes: Flake[] = [];
  let bits: Bit[] = [];

  function sizeCanvas(canvas: HTMLCanvasElement) {
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvas.width = innerWidth * dpr;
    canvas.height = innerHeight * dpr;
    canvas.getContext('2d')?.setTransform(dpr, 0, 0, dpr, 0, 0);
  }

  function seedSnow() {
    const count = Math.min(170, Math.floor(innerWidth / 8));
    flakes = Array.from({ length: count }, () => ({
      x: Math.random() * innerWidth,
      y: Math.random() * innerHeight,
      r: rand(0.5, 2.5),
      vy: rand(0.25, 0.85),
      vx: rand(-0.1, 0.3),
      a: rand(0.3, 0.8),
    }));
  }

  // Brilho pré-renderizado (desenhar imagem é bem mais barato que gradiente por partícula).
  const glowSprite = (() => {
    const c = document.createElement('canvas');
    c.width = c.height = 64;
    const g = c.getContext('2d');
    if (g) {
      const grad = g.createRadialGradient(32, 32, 0, 32, 32, 32);
      grad.addColorStop(0, 'rgba(255, 236, 200, 1)');
      grad.addColorStop(0.35, 'rgba(255, 180, 90, 0.6)');
      grad.addColorStop(1, 'rgba(255, 140, 60, 0)');
      g.fillStyle = grad;
      g.fillRect(0, 0, 64, 64);
    }
    return c;
  })();

  /** Ponto do desenho da porta (coordenadas do viewBox) em pixels de tela. */
  function toScreen(x: number, y: number) {
    const ctm = frameSvg.getScreenCTM();
    if (!ctm) return { x: innerWidth / 2, y: innerHeight / 2 };
    const p = new DOMPoint(x, y).matrixTransform(ctm);
    return { x: p.x, y: p.y };
  }

  /** Lufada de neve e fagulhas saindo do chão (quando a porta brota). */
  function burst(count: number, x0: number, x1: number, y: number, power = 1) {
    for (let i = 0; i < count; i++) {
      const p = toScreen(rand(x0, x1), y);
      const ember = Math.random() < 0.35;
      bits.push({
        x: p.x,
        y: p.y,
        vx: rand(-2.2, 2.2) * power,
        vy: rand(-4.5, -1.2) * power,
        life: 0,
        max: rand(50, 95),
        size: ember ? rand(1.2, 2.4) : rand(1.5, 3.5),
        ember,
      });
    }
  }

  function frame() {
    if (snowCtx) {
      snowCtx.clearRect(0, 0, innerWidth, innerHeight);
      snowCtx.fillStyle = '#fff';
      for (const f of flakes) {
        f.y += f.vy; f.x += f.vx;
        if (f.y > innerHeight) { f.y = -8; f.x = Math.random() * innerWidth; }
        if (f.x > innerWidth) f.x = 0; else if (f.x < 0) f.x = innerWidth;
        snowCtx.globalAlpha = f.a;
        snowCtx.beginPath();
        snowCtx.arc(f.x, f.y, f.r, 0, Math.PI * 2);
        snowCtx.fill();
      }
      snowCtx.globalAlpha = 1;
    }
    if (fxCtx) {
      fxCtx.clearRect(0, 0, innerWidth, innerHeight);
      bits = bits.filter((b) => b.life < b.max);
      for (const b of bits) {
        b.life++;
        b.x += b.vx;
        b.y += b.vy;
        b.vy += b.ember ? -0.01 : 0.06; // fagulha sobe, neve cai
        b.vx *= 0.985;
        const alpha = 1 - b.life / b.max;
        if (b.ember) {
          const r = b.size * 4;
          fxCtx.globalCompositeOperation = 'lighter';
          fxCtx.globalAlpha = alpha;
          fxCtx.drawImage(glowSprite, b.x - r, b.y - r, r * 2, r * 2);
          fxCtx.globalCompositeOperation = 'source-over';
        } else {
          fxCtx.globalAlpha = alpha * 0.8;
          fxCtx.fillStyle = '#eef3fb';
          fxCtx.beginPath();
          fxCtx.arc(b.x, b.y, b.size, 0, Math.PI * 2);
          fxCtx.fill();
        }
      }
      fxCtx.globalAlpha = 1;
    }
    requestAnimationFrame(frame);
  }

  function resize() {
    sizeCanvas(snowCanvas);
    sizeCanvas(fxCanvas);
    seedSnow();
  }

  // ── Montagem: as peças brotam do chão e se encaixam ───────────
  const q = (sel: string) => gsap.utils.toArray<SVGGraphicsElement>(sel);
  const sills = q('.piece.sill');
  const jambs = q('.piece.jamb').sort((a, b) => Number(a.dataset.order) - Number(b.dataset.order));
  const planks = q('.piece.plank');
  const irons = q('.piece.iron');
  const handles = q('.piece.handle');
  const voussoirs = q('.piece.voussoir:not(.keystone)').sort((a, b) => Number(a.dataset.order) - Number(b.dataset.order));
  const keystone = q('.piece.keystone');

  /** Estado "ainda no chão": abaixo, girada, pequena e invisível. */
  function scatter(el: Element, depth = 1) {
    gsap.set(el, {
      transformOrigin: '50% 100%',
      x: rand(-40, 40) * depth,
      y: rand(70, 170) * depth,
      rotation: rand(-70, 70),
      scale: rand(0.25, 0.6),
      opacity: 0,
    });
  }

  const snap = { x: 0, y: 0, rotation: 0, scale: 1, opacity: 1, ease: 'back.out(1.7)' };

  function buildAssembly(): gsap.core.Timeline {
    [...sills, ...jambs, ...voussoirs, ...keystone].forEach((el) => scatter(el));
    planks.forEach((el) => scatter(el, 1.4));
    [...irons, ...handles].forEach((el) => scatter(el, 0.7));

    const tl = gsap.timeline({ paused: true });
    tl.to('#narrative-text', { opacity: 0, y: -20, duration: 0.9, ease: 'power2.in' }, 0)
      .to('#door-floor', { opacity: 0.7, duration: 1, ease: 'sine.out' }, 0.5)
      .add(() => burst(innerWidth < 600 ? 50 : 80, 30, 270, 455), 1.25)
      .to(sills, { ...snap, duration: 0.45, stagger: 0.05 }, 1.2)
      .to(jambs, { ...snap, duration: 0.5, stagger: 0.07 }, 1.3)
      .to(planks, { ...snap, duration: 0.6, stagger: { each: 0.05, from: 'edges' } }, 1.4)
      .to(voussoirs, { ...snap, duration: 0.45, stagger: 0.06 }, 1.75)
      .to([...irons, ...handles], { ...snap, duration: 0.4, stagger: 0.04 }, 1.95)
      // A chave do arco chega por último, com um tranco.
      .to(keystone, { ...snap, duration: 0.5, ease: 'back.out(3)' }, 2.25)
      .add(() => burst(18, 135, 165, 95, 0.6), 2.5)
      .fromTo('#door-float', { y: 0 }, { y: 3, duration: 0.07, yoyo: true, repeat: 3, ease: 'none' }, 2.55)
      .to('#door-glint', { opacity: 1, duration: 0.1 }, 2.7)
      .to('#door-glint', { backgroundPosition: '-20% 0', duration: 0.9, ease: 'power2.inOut' }, 2.7)
      .to('#door-glint', { opacity: 0, duration: 0.3 }, 3.4)
      .to('.snow-cap', { opacity: 1, duration: 1.4, ease: 'sine.out' }, 2.9)
      .to('#door-halo', { opacity: 1, duration: 1.5, ease: 'sine.out' }, 2.9)
      .to(['#door-sill-light', '#door-seam'], { opacity: 1, duration: 1.2, ease: 'sine.out' }, 3.1)
      .to('#door-prompt', { opacity: 1, duration: 1.2 }, 3.8);
    return tl;
  }

  /** Luz de lareira escapando pelas frestas, tremulando. */
  function idle() {
    gsap.to(['#door-sill-light', '#door-seam'], {
      opacity: () => rand(0.55, 1),
      duration: () => rand(0.12, 0.35),
      repeat: -1,
      repeatRefresh: true,
      ease: 'sine.inOut',
    });
    gsap.to('#door-prompt', { opacity: 0.45, duration: 1.6, yoyo: true, repeat: -1, ease: 'sine.inOut', delay: 1 });
  }

  function openDoor(): Promise<void> {
    return new Promise((resolve) => {
      gsap.killTweensOf(['#door-sill-light', '#door-seam', '#door-prompt']);
      const tl = gsap.timeline({ onComplete: resolve });
      tl.to('#door-prompt', { opacity: 0, duration: 0.3 }, 0)
        .to('.ring', { attr: { stroke: '#e9b45f' }, duration: 0.25 }, 0)
        .to('#door-inner-light', { opacity: 1, duration: 0.35 }, 0.1)
        // Entreabre, como na referência: a luz é que invade.
        .to('#leaf-left', { rotationY: 26, duration: 0.9, ease: 'power2.out' }, 0.15)
        .to('#leaf-right', { rotationY: -26, duration: 0.9, ease: 'power2.out' }, 0.15)
        .to('#door-seam', { opacity: 1, width: '18%', marginLeft: '-9%', duration: 0.6, ease: 'power2.in' }, 0.15)
        .to('#door-halo', { opacity: 1, scale: 1.8, duration: 0.9, ease: 'power2.in' }, 0.2)
        .add(() => burst(30, 120, 180, 300, 0.8), 0.3)
        .to('#door-float', { scale: 1.35, duration: 1.2, ease: 'power2.in' }, 0.3)
        .to('#flash', { opacity: 1, duration: 0.55, ease: 'power2.in' }, 0.6)
        .to({}, { duration: 0.35 });
    });
  }

  // ── Execução ──────────────────────────────────────────────────
  async function runExperience() {
    resize();
    requestAnimationFrame(frame);
    announce('Tempestade de neve. Uma porta de taverna surge à sua frente.');
    audioSystem.init();
    audioSystem.transitionTo('tavern');

    const assembly = buildAssembly();
    let opened = false;

    const open = async () => {
      if (opened) return;
      opened = true;
      doorBtn.disabled = true;
      // Tocou antes de terminar a montagem: completa na hora e abre.
      if (assembly.progress() < 1) assembly.progress(1);
      if (!audioSystem.ready) audioSystem.init();
      audioSystem.setMuted(false, 600);
      audioSystem.transitionTo('door-open', 300);
      soundBtn?.setAttribute('aria-pressed', 'true');
      announce('Abrindo a porta...');
      if (reducedMotion) {
        redirectToSite();
        return;
      }
      await openDoor();
      audioSystem.transitionTo('tavern', 600);
      redirectToSite();
    };

    doorBtn.addEventListener('click', open);
    document.addEventListener('keydown', (event) => {
      if ((event.key === 'Enter' || event.key === ' ') && !doorBtn.disabled) {
        event.preventDefault();
        void open();
      }
    });

    if (reducedMotion) {
      assembly.progress(1);
      doorBtn.disabled = false;
      announce('Uma porta de taverna está à sua frente. Toque para entrar.');
      return;
    }

    // As frases levam ~7 s; a porta brota logo depois de "Uma luz surge à sua frente".
    await wait(7600);
    doorBtn.disabled = false;
    assembly.eventCallback('onComplete', () => {
      announce('Uma porta de taverna está à sua frente. Toque para entrar.');
      idle();
    });
    assembly.play();
  }

  skipBtn?.addEventListener('click', () => {
    audioSystem.init();
    audioSystem.transitionTo('tavern', 300);
    redirectToSite();
  });

  soundBtn?.addEventListener('click', () => {
    audioSystem.init();
    const muted = audioSystem.toggleMute();
    soundBtn.setAttribute('aria-pressed', String(!muted));
    soundBtn.setAttribute('aria-label', muted ? 'Ativar som' : 'Desativar som');
  });

  window.addEventListener('resize', resize);
  void runExperience();
</script>
