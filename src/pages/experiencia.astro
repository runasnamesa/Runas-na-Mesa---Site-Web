---
/**
 * Runas na Mesa — Experiência Interativa
 * Tela de seleção estilo jogo com espada cravada
 */
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Experiência — Runas na Mesa</title>
    <meta name="description" content="Entre na experiência interativa de Runas na Mesa" />
    <meta name="theme-color" content="#0a1628" />
    
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
  </head>
  <body>
    <div class="experience-scene">
      <!-- Sky Background with Stars -->
      <div class="sky-gradient"></div>
      <canvas id="stars-canvas" class="stars-layer"></canvas>
      
      <!-- Moon -->
      <div class="moon">
        <div class="moon-glow"></div>
      </div>

      <!-- Animated Clouds -->
      <div class="clouds-layer">
        <div class="cloud cloud-1"></div>
        <div class="cloud cloud-2"></div>
        <div class="cloud cloud-3"></div>
        <div class="cloud cloud-4"></div>
        <div class="cloud cloud-5"></div>
      </div>

      <!-- Ruins Background -->
      <div class="ruins-layer">
        <div class="ruin-column ruin-left-1"></div>
        <div class="ruin-column ruin-left-2"></div>
        <div class="ruin-column ruin-right-1"></div>
        <div class="ruin-column ruin-right-2"></div>
        <div class="ruin-arch"></div>
      </div>

      <!-- Central Platform with Sword -->
      <div class="platform-container">
        <div class="platform-base"></div>
        <div class="sword-container">
          <div class="sword-blade"></div>
          <div class="sword-guard"></div>
          <div class="sword-handle"></div>
          <div class="sword-glow"></div>
        </div>
      </div>

      <!-- UI Controls -->
      <div class="ui-corner ui-top-left">
        <button class="icon-btn power-btn" aria-label="Power">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2v10M18.36 6.64a9 9 0 1 1-12.73 0"/>
          </svg>
        </button>
      </div>

      <div class="ui-corner ui-top-right">
        <button class="icon-btn settings-btn" aria-label="Configurações">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"/>
          </svg>
        </button>

        <button class="icon-btn save-btn" aria-label="Salvar">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
            <path d="M15,9H5V5H15M12,19A3,3 0 0,1 9,16A3,3 0 0,1 12,13A3,3 0 0,1 15,16A3,3 0 0,1 12,19M17,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3Z"/>
          </svg>
        </button>

        <button class="icon-btn book-btn" aria-label="Livro">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18,2A2,2 0 0,1 20,4V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V4A2,2 0 0,1 6,2H18M18,4H13V12L10.5,9.75L8,12V4H6V20H18V4Z"/>
          </svg>
        </button>
      </div>

      <!-- Call to Action -->
      <div class="cta-container">
        <button class="cta-button" id="begin-btn">
          <span class="cta-text">CLICK TO BEGIN</span>
          <span class="cta-underline"></span>
        </button>
      </div>

      <!-- Fog Layer -->
      <canvas id="fog-canvas" class="fog-layer"></canvas>
    </div>

    <style>
      *, *::before, *::after {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html, body {
        width: 100%;
        height: 100%;
        overflow: hidden;
        font-family: 'Cinzel', serif;
      }

      .experience-scene {
        position: relative;
        width: 100%;
        height: 100vh;
        overflow: hidden;
        background: linear-gradient(to bottom, 
          #0d1b3a 0%, 
          #152847 30%, 
          #1a3353 60%, 
          #1f3d5f 100%);
      }

      /* ═══════════════════════════════════════════════════════════
         SKY & STARS
         ═══════════════════════════════════════════════════════════ */
      .sky-gradient {
        position: absolute;
        inset: 0;
        background: radial-gradient(ellipse at 20% 10%, rgba(100, 180, 255, 0.15) 0%, transparent 50%);
        pointer-events: none;
      }

      .stars-layer {
        position: absolute;
        inset: 0;
        opacity: 0.6;
        pointer-events: none;
      }

      /* ═══════════════════════════════════════════════════════════
         MOON
         ═══════════════════════════════════════════════════════════ */
      .moon {
        position: absolute;
        left: 12%;
        top: 5%;
        width: 220px;
        height: 220px;
        background: radial-gradient(circle at 35% 35%, #f5f9ff 0%, #d8e8f8 40%, #a8c8e8 100%);
        border-radius: 50%;
        box-shadow: 
          0 0 60px rgba(200, 230, 255, 0.8),
          0 0 120px rgba(150, 200, 255, 0.5),
          inset -15px -15px 40px rgba(100, 150, 200, 0.2);
        animation: moonPulse 8s ease-in-out infinite;
      }

      .moon-glow {
        position: absolute;
        inset: -50px;
        background: radial-gradient(circle, rgba(180, 220, 255, 0.4) 0%, transparent 70%);
        border-radius: 50%;
        filter: blur(30px);
        animation: moonGlowPulse 8s ease-in-out infinite;
      }

      @keyframes moonPulse {
        0%, 100% { transform: scale(1); opacity: 1; }
        50% { transform: scale(1.05); opacity: 0.95; }
      }

      @keyframes moonGlowPulse {
        0%, 100% { opacity: 0.6; }
        50% { opacity: 0.8; }
      }

      /* ═══════════════════════════════════════════════════════════
         CLOUDS
         ═══════════════════════════════════════════════════════════ */
      .clouds-layer {
        position: absolute;
        inset: 0;
        pointer-events: none;
      }

      .cloud {
        position: absolute;
        background: rgba(100, 180, 230, 0.3);
        border-radius: 100px;
        filter: blur(15px);
        animation: cloudFloat 60s linear infinite;
      }

      .cloud::before,
      .cloud::after {
        content: '';
        position: absolute;
        background: inherit;
        border-radius: inherit;
      }

      .cloud-1 {
        width: 200px;
        height: 60px;
        top: 15%;
        left: -10%;
        animation-duration: 80s;
      }

      .cloud-1::before {
        width: 150px;
        height: 50px;
        top: -25px;
        left: 30px;
      }

      .cloud-2 {
        width: 180px;
        height: 50px;
        top: 25%;
        left: 50%;
        animation-duration: 100s;
      }

      .cloud-3 {
        width: 160px;
        height: 55px;
        top: 20%;
        right: 10%;
        animation-duration: 90s;
      }

      .cloud-4 {
        width: 140px;
        height: 45px;
        top: 35%;
        left: 20%;
        animation-duration: 110s;
      }

      .cloud-5 {
        width: 190px;
        height: 65px;
        top: 30%;
        right: -5%;
        animation-duration: 95s;
      }

      @keyframes cloudFloat {
        0% { transform: translateX(0); }
        100% { transform: translateX(120vw); }
      }

      /* ═══════════════════════════════════════════════════════════
         RUINS
         ═══════════════════════════════════════════════════════════ */
      .ruins-layer {
        position: absolute;
        inset: 0;
        pointer-events: none;
      }

      .ruin-column {
        position: absolute;
        bottom: 20%;
        width: 100px;
        height: 280px;
        background: linear-gradient(to bottom, 
          rgba(35, 60, 90, 0.3) 0%,
          rgba(30, 50, 80, 0.4) 50%,
          rgba(25, 45, 75, 0.5) 100%);
        clip-path: polygon(25% 0%, 75% 0%, 80% 100%, 20% 100%);
        filter: blur(4px);
        opacity: 0.6;
      }

      .ruin-left-1 {
        left: 8%;
        height: 260px;
        transform: rotate(-1deg);
      }

      .ruin-left-2 {
        left: 18%;
        height: 300px;
        transform: rotate(0.5deg);
      }

      .ruin-right-1 {
        right: 8%;
        height: 270px;
        transform: rotate(1deg);
      }

      .ruin-right-2 {
        right: 18%;
        height: 290px;
        transform: rotate(-0.5deg);
      }

      .ruin-arch {
        position: absolute;
        bottom: 25%;
        left: 50%;
        transform: translateX(-50%);
        width: 180px;
        height: 320px;
        background: linear-gradient(to bottom, 
          rgba(30, 55, 85, 0.4),
          rgba(25, 45, 75, 0.5));
        clip-path: polygon(
          35% 0%, 65% 0%,
          70% 20%, 70% 100%,
          30% 100%, 30% 20%
        );
        filter: blur(4px);
        opacity: 0.5;
      }

      /* ═══════════════════════════════════════════════════════════
         PLATFORM & SWORD
         ═══════════════════════════════════════════════════════════ */
      .platform-container {
        position: absolute;
        bottom: 18%;
        left: 50%;
        transform: translateX(-50%);
        perspective: 1200px;
      }

      .platform-base {
        width: 450px;
        height: 120px;
        background: linear-gradient(to bottom,
          rgba(50, 80, 110, 0.85) 0%,
          rgba(40, 70, 100, 0.9) 50%,
          rgba(30, 55, 85, 0.95) 100%);
        transform: rotateX(65deg);
        position: relative;
        box-shadow: 
          0 30px 80px rgba(0, 0, 0, 0.7),
          inset 0 -5px 15px rgba(0, 0, 0, 0.3);
        border-radius: 4px;
      }

      .platform-base::before {
        content: '';
        position: absolute;
        inset: 15px;
        background: linear-gradient(135deg,
          rgba(70, 100, 130, 0.2) 0%,
          transparent 50%);
        border-radius: 2px;
      }

      .sword-container {
        position: absolute;
        left: 50%;
        bottom: 60px;
        transform: translateX(-50%);
        width: 30px;
        height: 350px;
        animation: swordGlow 3s ease-in-out infinite;
      }

      .sword-blade {
        position: absolute;
        left: 50%;
        bottom: 0;
        transform: translateX(-50%);
        width: 8px;
        height: 220px;
        background: linear-gradient(to right,
          rgba(140, 170, 190, 0.85) 0%,
          rgba(200, 220, 240, 1) 50%,
          rgba(140, 170, 190, 0.85) 100%);
        clip-path: polygon(50% 0%, 48% 3%, 45% 100%, 55% 100%, 52% 3%);
        filter: drop-shadow(0 0 12px rgba(150, 200, 255, 0.7));
      }

      .sword-guard {
        position: absolute;
        left: 50%;
        bottom: 220px;
        transform: translateX(-50%);
        width: 70px;
        height: 10px;
        background: linear-gradient(to bottom,
          rgba(100, 80, 60, 0.95),
          rgba(70, 60, 50, 1));
        border-radius: 3px;
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.6);
      }

      .sword-handle {
        position: absolute;
        left: 50%;
        bottom: 245px;
        transform: translateX(-50%);
        width: 16px;
        height: 70px;
        background: linear-gradient(to right,
          rgba(55, 45, 35, 1) 0%,
          rgba(85, 70, 55, 1) 50%,
          rgba(55, 45, 35, 1) 100%);
        border-radius: 4px;
        box-shadow: 
          inset 0 2px 5px rgba(0, 0, 0, 0.5),
          0 2px 8px rgba(0, 0, 0, 0.6);
      }

      .sword-handle::before {
        content: '';
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 20px;
        height: 20px;
        background: radial-gradient(circle, rgba(95, 80, 65, 1), rgba(65, 55, 45, 1));
        border-radius: 50%;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.7);
      }

      .sword-glow {
        position: absolute;
        left: 50%;
        bottom: 0;
        transform: translateX(-50%);
        width: 25px;
        height: 240px;
        background: linear-gradient(to top,
          transparent 0%,
          rgba(140, 190, 240, 0.15) 30%,
          rgba(170, 210, 250, 0.35) 70%,
          rgba(190, 225, 255, 0.5) 100%);
        filter: blur(12px);
        animation: swordGlowPulse 3s ease-in-out infinite;
      }

      @keyframes swordGlow {
        0%, 100% { filter: drop-shadow(0 0 15px rgba(140, 190, 240, 0.3)); }
        50% { filter: drop-shadow(0 0 30px rgba(160, 210, 255, 0.6)); }
      }

      @keyframes swordGlowPulse {
        0%, 100% { opacity: 0.6; }
        50% { opacity: 1; }
      }

      /* ═══════════════════════════════════════════════════════════
         UI CONTROLS
         ═══════════════════════════════════════════════════════════ */
      .ui-corner {
        position: absolute;
        display: flex;
        gap: 16px;
        z-index: 100;
      }

      .ui-top-left {
        top: 32px;
        left: 32px;
      }

      .ui-top-right {
        top: 32px;
        right: 32px;
        flex-direction: column;
      }

      .icon-btn {
        width: 50px;
        height: 50px;
        border: none;
        background: rgba(15, 30, 50, 0.5);
        backdrop-filter: blur(8px);
        border-radius: 50%;
        color: rgba(255, 255, 255, 0.7);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
        box-shadow: 
          0 2px 8px rgba(0, 0, 0, 0.2),
          inset 0 1px 1px rgba(255, 255, 255, 0.05);
      }

      .icon-btn:hover {
        background: rgba(25, 45, 70, 0.7);
        color: rgba(255, 255, 255, 0.95);
        transform: scale(1.08);
        box-shadow: 
          0 4px 16px rgba(0, 0, 0, 0.3),
          0 0 15px rgba(100, 150, 255, 0.2);
      }

      .icon-btn:active {
        transform: scale(0.96);
      }

      .power-btn {
        background: rgba(30, 15, 15, 0.5);
      }

      .power-btn:hover {
        background: rgba(50, 25, 25, 0.7);
        box-shadow: 
          0 4px 16px rgba(0, 0, 0, 0.3),
          0 0 15px rgba(255, 100, 100, 0.3);
      }

      /* ═══════════════════════════════════════════════════════════
         CALL TO ACTION
         ═══════════════════════════════════════════════════════════ */
      .cta-container {
        position: absolute;
        bottom: 10%;
        left: 50%;
        transform: translateX(-50%);
        z-index: 50;
      }

      .cta-button {
        background: transparent;
        border: none;
        cursor: pointer;
        padding: 0;
        position: relative;
        transition: transform 0.3s ease;
      }

      .cta-button:hover {
        transform: scale(1.03);
      }

      .cta-text {
        display: block;
        font-family: 'Cinzel', serif;
        font-size: 20px;
        font-weight: 400;
        letter-spacing: 4px;
        color: rgba(255, 255, 255, 0.85);
        text-shadow: 
          0 2px 10px rgba(0, 0, 0, 0.7),
          0 0 15px rgba(150, 200, 255, 0.3);
        animation: ctaPulse 2.5s ease-in-out infinite;
      }

      .cta-underline {
        display: block;
        width: 0%;
        height: 1px;
        background: linear-gradient(to right,
          transparent,
          rgba(200, 230, 255, 0.7),
          transparent);
        margin-top: 10px;
        animation: underlineExpand 2.5s ease-in-out infinite;
        box-shadow: 0 0 8px rgba(150, 200, 255, 0.5);
      }

      @keyframes ctaPulse {
        0%, 100% { opacity: 0.75; }
        50% { opacity: 1; }
      }

      @keyframes underlineExpand {
        0%, 100% { width: 0%; margin-left: 50%; }
        50% { width: 100%; margin-left: 0%; }
      }

      /* ═══════════════════════════════════════════════════════════
         FOG LAYER
         ═══════════════════════════════════════════════════════════ */
      .fog-layer {
        position: absolute;
        inset: 0;
        opacity: 0.3;
        pointer-events: none;
      }

      /* ═══════════════════════════════════════════════════════════
         RESPONSIVE
         ═══════════════════════════════════════════════════════════ */
      @media (max-width: 768px) {
        .moon {
          width: 140px;
          height: 140px;
          left: 8%;
          top: 3%;
        }

        .ruin-column {
          width: 70px;
          height: 200px;
        }

        .platform-base {
          width: 320px;
          height: 90px;
        }

        .sword-container {
          height: 250px;
          bottom: 45px;
        }

        .sword-blade {
          height: 160px;
          width: 6px;
        }

        .sword-guard {
          bottom: 160px;
          width: 50px;
        }

        .sword-handle {
          bottom: 180px;
          height: 50px;
          width: 14px;
        }

        .sword-glow {
          height: 180px;
          width: 20px;
        }

        .ui-corner {
          gap: 10px;
        }

        .ui-top-left,
        .ui-top-right {
          top: 16px;
        }

        .ui-top-left { left: 16px; }
        .ui-top-right { right: 16px; }

        .icon-btn {
          width: 44px;
          height: 44px;
        }

        .cta-text {
          font-size: 16px;
          letter-spacing: 3px;
        }

        .cta-container {
          bottom: 8%;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        * {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>

    <script>
      // Stars System
      class StarsSystem {
        canvas: HTMLCanvasElement;
        ctx: CanvasRenderingContext2D | null;
        stars: Array<{x: number; y: number; size: number; opacity: number; twinkleSpeed: number}>;

        constructor(canvas: HTMLCanvasElement) {
          this.canvas = canvas;
          this.ctx = canvas.getContext('2d');
          this.stars = [];
          this.resize();
          this.init();
        }

        resize() {
          this.canvas.width = window.innerWidth;
          this.canvas.height = window.innerHeight;
        }

        init() {
          const count = 200;
          for (let i = 0; i < count; i++) {
            this.stars.push({
              x: Math.random() * this.canvas.width,
              y: Math.random() * this.canvas.height * 0.6, // Top 60% of screen
              size: Math.random() * 1.5 + 0.5,
              opacity: Math.random(),
              twinkleSpeed: Math.random() * 0.02 + 0.005
            });
          }
        }

        update() {
          if (!this.ctx) return;
          this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);

          for (const star of this.stars) {
            star.opacity += star.twinkleSpeed;
            if (star.opacity >= 1 || star.opacity <= 0) {
              star.twinkleSpeed *= -1;
            }

            this.ctx.beginPath();
            this.ctx.arc(star.x, star.y, star.size, 0, Math.PI * 2);
            this.ctx.fillStyle = `rgba(255, 255, 255, ${Math.max(0, Math.min(1, star.opacity))})`;
            this.ctx.fill();
          }
        }

        animate() {
          this.update();
          requestAnimationFrame(() => this.animate());
        }
      }

      // Fog System
      class FogSystem {
        canvas: HTMLCanvasElement;
        ctx: CanvasRenderingContext2D | null;
        particles: Array<{x: number; y: number; radius: number; speedX: number; opacity: number}>;

        constructor(canvas: HTMLCanvasElement) {
          this.canvas = canvas;
          this.ctx = canvas.getContext('2d');
          this.particles = [];
          this.resize();
          this.init();
        }

        resize() {
          this.canvas.width = window.innerWidth;
          this.canvas.height = window.innerHeight;
        }

        init() {
          const count = 30;
          for (let i = 0; i < count; i++) {
            this.particles.push({
              x: Math.random() * this.canvas.width,
              y: Math.random() * this.canvas.height,
              radius: Math.random() * 80 + 40,
              speedX: Math.random() * 0.2 - 0.1,
              opacity: Math.random() * 0.15 + 0.05
            });
          }
        }

        update() {
          if (!this.ctx) return;
          this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);

          for (const p of this.particles) {
            p.x += p.speedX;

            if (p.x > this.canvas.width + p.radius) {
              p.x = -p.radius;
            }
            if (p.x < -p.radius) {
              p.x = this.canvas.width + p.radius;
            }

            this.ctx.beginPath();
            this.ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
            const gradient = this.ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, p.radius);
            gradient.addColorStop(0, `rgba(100, 150, 200, ${p.opacity})`);
            gradient.addColorStop(1, 'rgba(100, 150, 200, 0)');
            this.ctx.fillStyle = gradient;
            this.ctx.fill();
          }
        }

        animate() {
          this.update();
          requestAnimationFrame(() => this.animate());
        }
      }

      // Initialize systems
      const starsCanvas = document.getElementById('stars-canvas') as HTMLCanvasElement;
      const fogCanvas = document.getElementById('fog-canvas') as HTMLCanvasElement;

      if (starsCanvas && fogCanvas) {
        const stars = new StarsSystem(starsCanvas);
        const fog = new FogSystem(fogCanvas);
        
        stars.animate();
        fog.animate();

        window.addEventListener('resize', () => {
          stars.resize();
          fog.resize();
        });
      }

      // Button interactions
      const beginBtn = document.getElementById('begin-btn');
      const powerBtn = document.querySelector('.power-btn');
