      // Sword interaction (optional hover effect)
      const swordContainer = document.querySelector('.sword-container') as HTMLElement;
      swordContainer?.addEventListener('mouseenter', () => {
        if (swordContainer) {
          swordContainer.style.filter = 'drop-shadow(0 0 40px rgba(150, 200, 255, 0.9))';
        }
      });

      swordContainer?.addEventListener('mouseleave', () => {
        if (swordContainer) {
          swordContainer.style.filter = '';
        }
      });
    </script>
